(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

{$RAKAZO_HOST:app.example.com} {
	encode zstd gzip

	# A localhost trial must not pin HTTPS onto every local dev server.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# SAMEORIGIN still lets the app frame its own /novnc/ screen.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}

	# The share page keeps its link token in the URL fragment: no referrer, and no framing at all.
	@share path /s
	header @share {
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}

	handle /health {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	# Outside AI clients: the MCP endpoint and its OAuth discovery documents are served by the API.
	# Exact /mcp only: /mcp/oauth/callback is a web app page.
	handle /mcp {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /.well-known/oauth-* {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:3100 {
			import deploy_retry
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /rpc/* {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle {
		reverse_proxy web:5173 {
			import deploy_retry
		}
	}
}
